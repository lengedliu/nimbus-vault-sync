PORT=3000
DATA_DIR=./data
JWT_SECRET=dev-only-insecure-secret
TOKEN_TTL=30d
TLS_CERT_PATH=
TLS_KEY_PATH=
# 部署在反向代理（Nginx/Caddy/Cloud Run/Traefik）或容器后时设为 1，直接裸跑暴露公网时设为 0。默认 1。
TRUST_PROXY=1

# Database Configuration (supports sqlite | postgres | mysql | json)
DB_TYPE=sqlite
# SQLite config
SQLITE_PATH=./data/nimbus.sqlite

# PostgreSQL config (alternative)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/nimbus
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=postgres
# PG_PASSWORD=
# PG_DATABASE=nimbus

# MySQL config (alternative)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=nimbus
