# Server Configuration
PORT=3000
NODE_ENV=development
DATA_DIR=./data
TOKEN_TTL=30d

# Security & Authentication
JWT_SECRET=
INITIAL_ADMIN_PASSWORD=admin123
ENCRYPTION_KEY=
CORS_ALLOWED_ORIGINS=
TRUST_PROXY=1

# Storage Limits
MAX_UPLOAD_MB=100
ATTACHMENT_MAX_MB=100
MAX_DELTA_CHANGES_PER_VAULT=10000
MAX_DELTA_CHANGES_AGE_DAYS=90

# Database Configuration (Optional: json, sqlite, postgres, mysql; defaults to json)
DB_TYPE=json
SQLITE_PATH=
DATABASE_URL=
PG_HOST=
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=
PG_SSL=false
PG_SSL_CA=
PG_SSL_CA_PATH=
PG_SSL_REJECT_UNAUTHORIZED=true
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# TLS (Optional)
TLS_CERT_PATH=
TLS_KEY_PATH=
