{
  "name": "nimbus-vault-sync",
  "version": "1.2.0",
  "description": "Nimbus Vault Sync - a lightweight self-hosted sync + management server for Obsidian vaults, with MCP support",
  "homepage": "https://github.com/lengedliu/nimbus-vault-sync",
  "repository": {
    "type": "git",
    "url": "https://github.com/lengedliu/nimbus-vault-sync.git"
  },
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "echo 'Build complete'",
    "lint": "node -c server.js src/*.js src/*/*.js",
    "check:permissions": "node scripts/check-permission-consistency.js",
    "test": "node --test \"test/*.test.js\"",
    "verify": "npm run lint && npm run check:permissions && npm test",
    "create-user": "node src/cli/createUser.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "archiver": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.24.2",
    "pg": "^8.23.0",
    "sqlite3": "^6.0.1",
    "uuid": "^9.0.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  }
}
